--class-path ../src
--class-path src
--library utest:git:https://github.com/haxe-utest/utest#a055e05e2e872ae12a32b53d0200612345059c38
--library instrument:1.4.0

--define coverage-console-summary-reporter
--define coverage-lcov-reporter=lcov.info
--define instrument-quiet
--define no-deprecation-warnings

--macro addMetadata("@:build(InstrumentationPatcher.patch())", "instrument.Instrumentation")
--macro instrument.Instrumentation.coverage(["lazylambda"], ["../src"], [])
--main TestSuiteMain

--each

--library hashlink
--define hl-ver=1.14.0
--hl out/hashlink/suite.hl

--next
--library hxnodejs
--define js-es=6
--js out/nodejs/suite.js

--next
--library hxcpp
--define no-compilation
--cpp out/cpp/

--next
--library hxjava
--jvm out/java/suite.jar

--next
--define lua-ver=5.1
--lua out/lua/suite.lua

--next
--python out/python/suite.py
